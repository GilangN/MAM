selectAllBtn.MouseButton1Click:Connect(function()
    allSelected = not allSelected
    for _, obj in ipairs(itemFrames) do
        obj.data.enabled = allSelected
        if allSelected then
            obj.btn.BackgroundColor3 = Color3.fromRGB(40, 150, 70)
            obj.btn.Text = "✓"
        else
            obj.btn.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
            obj.btn.Text = ""
        end
    end
end)

-- Logika Search / Filter Item
searchBox:GetPropertyChangedSignal("Text"):Connect(function()
    local query = string.lower(searchBox.Text)
    for _, obj in ipairs(itemFrames) do
        if query == "" or obj.name:find(query) then
            obj.frame.Visible = true
        else
            obj.frame.Visible = false
        end
    end
    updateCanvasSize()
end)

